<?xml version="1.0" encoding="utf-8"?>
<!--
  车辆状态桌面小组件（2×3 网格）
  顶部：车图 + 「总续航 XXX km」大字 + 右侧三行状态；
  底部：电量/油量两行全宽进度条（文字左、进度条延伸到最右）。
  注意：RemoteViews 仅支持 FrameLayout/LinearLayout/RelativeLayout/GridLayout + 基础控件。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 顶部：车图 + 总续航大字 + 右侧状态列 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/widget_car_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="车辆" />

            <TextView
                android:id="@+id/widget_car_emoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🚗"
                android:textSize="30sp" />

            <!-- v61：离车异常角标（红底白字，如「⚠锁/窗」），仅异常时可见 -->
            <TextView
                android:id="@+id/widget_alert_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@drawable/widget_alert_badge_bg"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                android:maxLines="1" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_range_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="总续航 -- km"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1D21"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="13sp"
            android:autoSizeMaxTextSize="22sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/widget_power_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#9AA0A8" />

            <TextView
                android:id="@+id/widget_lock_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="--"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#9AA0A8" />

            <TextView
                android:id="@+id/widget_window_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="--"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#9AA0A8" />
        </LinearLayout>
    </LinearLayout>

    <!-- 中部弹性空白（RemoteViews 不支持 Space，用空 LinearLayout） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal" />

    <!-- 电量：图标 + 文字 + 全宽进度条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔋"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/widget_soc_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="电量 --"
                android:textSize="15sp"
                android:textColor="#2B3138"
                android:maxLines="1" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_soc_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="#2F80ED"
            android:progressBackgroundTint="#E1E6ED" />
    </LinearLayout>

    <!-- 油量：图标 + 文字 + 全宽进度条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="104dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛽"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/widget_fuel_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="油量 --"
                android:textSize="15sp"
                android:textColor="#2B3138"
                android:maxLines="1" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_fuel_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="#2F80ED"
            android:progressBackgroundTint="#E1E6ED" />
    </LinearLayout>

    <!-- v63：快捷控制按钮。vin 尚未缓存（首次使用/未刷新）时整行隐藏，点了也是空指令 -->
    <LinearLayout
        android:id="@+id/widget_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_btn_lock"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_button_bg"
            android:text="锁车"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#2B3138"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_btn_window"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/widget_button_bg"
            android:text="关窗"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#2B3138"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_btn_find"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:background="@drawable/widget_button_bg"
            android:text="寻车"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#2B3138"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
